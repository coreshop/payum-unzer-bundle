{
    "name": "coreshop/payum-unzer-bundle",
    "type": "pimcore-bundle",
    "description": "CoreShop - Unzer Payment Bundle",
    "keywords": [
        "coreshop",
        "pimcore",
        "ecommerce",
        "payment",
        "unzer",
        "payum"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "CoreShop GmbH",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "TEAM"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "coreshop/core-shop": "2026.x-dev",
        "coreshop/enterprise-subscription-bundle": "^2026.2",
        "coreshop/payum-unzer": "3.x-dev"
    },
    "require-dev": {
        "coreshop/test-setup": "1.0.x-dev",
        "pimcore/studio-ui-bundle": "^2026.2.1",
        "symfony/runtime": "^6.4 || ^7.0"
    },
    "suggest": {
        "pimcore/studio-ui-bundle": "^2026.2 - Pimcore Studio, the admin UI"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Payum\\UnzerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "Kernel.php"
        ],
        "psr-4": {
            "Pimcore\\Model\\DataObject\\": "var/classes/DataObject"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "pimcore": {
            "bundles": [
                "CoreShop\\Payum\\UnzerBundle\\UnzerBundle"
            ]
        }
    }
}
